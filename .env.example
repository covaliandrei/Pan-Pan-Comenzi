# Application Environment Variables
# Copy this file to .env and fill in your actual Firebase values

VITE_FIREBASE_PROJECT_ID="your_firebase_project_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_firebase_project_id.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="your_firestore_database_id"
VITE_FIREBASE_STORAGE_BUCKET="your_firebase_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_OAUTH_CLIENT_ID="your_oauth_client_id"
